<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <NativeInteropDir Condition="'$(NativeInteropDir)' == ''">..\FSvolLib\out\build\win-debug-x64\FSvolLib.interop\Debug</NativeInteropDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(NativeInteropDir)\FSvolLibInterop.dll"
          Link="FSvolLibInterop.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('$(NativeInteropDir)\FSvolLibInterop.dll')" />
  </ItemGroup>
</Project>
