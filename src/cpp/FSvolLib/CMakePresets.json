
{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21
  },
  "configurePresets": [
    {
      "name": "win-debug-x64",
      "displayName": "Windows Debug x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {}
    },
    {
      "name": "win-release-x64",
      "displayName": "Windows Release x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {}
    },
    {
      "name": "emscripten-wasm",
      "displayName": "Emscripten WASM",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "BUILD_INTEROP": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android ARM64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
        "BUILD_INTEROP": "ON",
        "ANDROID_ABI": "arm64-v8a",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-debug-x64-build",
      "configurePreset": "win-debug-x64"
    },
    {
      "name": "win-release-x64-build",
      "configurePreset": "win-release-x64"
    },
    {
      "name": "emscripten-wasm-build",
      "configurePreset": "emscripten-wasm"
    },
    {
      "name": "android-arm64-build",
      "configurePreset": "android-arm64"
    }
  ]
}
