<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<NativeInteropDir Condition="'$(NativeInteropDir)' == '' and Exists('..\..\FSvolLib\out\build\win-dev\FSvolLib\FSvolLib.interop\Debug\FSvolLibInterop.dll')">..\..\FSvolLib\out\build\win-dev\FSvolLib\FSvolLib.interop\Debug</NativeInteropDir>
		<NativeInteropDir Condition="'$(NativeInteropDir)' == '' and Exists('..\..\FSvolLib\out\build\win-debug-x64\FSvolLib.interop\Debug\FSvolLibInterop.dll')">..\..\FSvolLib\out\build\win-debug-x64\FSvolLib.interop\Debug</NativeInteropDir>
		<NativeInteropDir Condition="'$(NativeInteropDir)' == ''">..\..\FSvolLib\out\build\win-dev\FSvolLib\FSvolLib.interop\Debug</NativeInteropDir>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FSvolLib.Interop\FSvolLib.Interop.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="$(NativeInteropDir)\FSvolLibInterop.dll" Link="FSvolLibInterop.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NativeInteropDir)\FSvolLibInterop.dll')" />
	</ItemGroup>


</Project>
